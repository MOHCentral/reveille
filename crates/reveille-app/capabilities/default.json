{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core Reveille window capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/MOHCentral/reveille/issues/new*"
        },
        {
          "url": "https://github.com/MOHCentral/reveille/blob/main/README.md#telemetry"
        },
        {
          "url": "https://www.moh-db.com/*"
        }
      ]
    },
    "installation",
    "engines",
    "servers",
    "join",
    "catalogue",
    "alerts",
    "shell",
    "self-update",
    "telemetry"
  ]
}
